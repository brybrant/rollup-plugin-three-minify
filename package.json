{
  "name": "rollup-plugin-three-minify",
  "description": "Minify Three.js shader code, and remove redundant code",
  "keywords": [
    "rollup-plugin",
    "rolldown-plugin",
    "vite-plugin",
    "three",
    "minify"
  ],
  "author": "brybrant",
  "license": "GPL-3.0-only",
  "version": "3.0.2",
  "type": "module",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "./dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun generate-tests.ts && bun test --timeout 60000 --parallel=4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brybrant/rollup-plugin-three-minify.git"
  },
