{
  "name": "rollup-plugin-three-minify",
  "description": "Minify Three.js shader code, and remove redundant code",
  "keywords": [
    "rollup-plugin",
    "rolldown-plugin",
    "vite-plugin",
    "three",
    "minify"
  ],
  "author": "brybrant",
  "license": "GPL-3.0-only",
  "version": "3.0.1",
  "type": "module",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      },
      "require": {
        "default": "./dist/index.cjs",
        "types": "./dist/index.d.cts"
      }
    }
  },
  "files": [
    "./dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brybrant/rollup-plugin-three-minify.git"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.x"
  },
  "devDependencies": {
    "@brybrant/eslint-config": "^1.0.0",
    "@playwright/test": "^1.62.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/bun": "^1.3.14",
    "rollup": "^4.62.3",
    "rollup-plugin-three-minify": ".",
    "three": "latest",
    "tsdown": "^0.22.14",
    "vite": "^7.3.6"
  },
  "peerDependencies": {
    "three": ">= 0.135.0"
  }
}
