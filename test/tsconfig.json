{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitOverride": true,
    "strict": true,
    "target": "ESNext",
    "typeRoots": ["../node_modules/@types", "../types"],
    "types": ["bun", "three"],
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts"]
}